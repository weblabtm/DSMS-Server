{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "npm install --no-audit --no-fund",
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index"
        }
    ]
}