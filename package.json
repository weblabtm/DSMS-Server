{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts,json,env --exec tsx src/server.ts",
    "build": "tsc",
    "vercel-build": "npm run prisma:generate && npm run build",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:unit": "node -r dotenv/config ./node_modules/vitest/vitest.mjs run tests/unit tests/example.test.ts",
    "test:integration": "node -r dotenv/config ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "node -r dotenv/config ./node_modules/vitest/vitest.mjs run tests/e2e",
    "test:ci": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "seed:rbac": "tsx src/scripts/seed-rbac.ts",
    "seed:super-admin": "tsx src/scripts/bootstrap-super-admin.ts",
    "check:supabase-direct": "tsx src/scripts/check-supabase-direct.ts",
    "prisma:build-schema": "node scripts/build-prisma-schema.js",
    "prisma:generate": "npm run prisma:build-schema && prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "npm run prisma:build-schema && prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "npm run prisma:build-schema && prisma migrate deploy --schema=prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.55.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "minio": "^8.0.7",
    "prisma": "^7.8.0",
    "redis": "^5.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^1.0.0"
  }
}
