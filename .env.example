NODE_ENV=development
PORT=3000
POSTGRES_DB=dsms
POSTGRES_USER=dsms
POSTGRES_PASSWORD=dsms
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_CONSOLE_PORT=9001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql://your-user-name:your-password@localhost:5432/your-db-name?schema=public
DOCKER_DATABASE_URL=postgresql://dsms:dsms@postgres:5432/dsms?schema=public

REDIS_URL=rediss://default:your-password@your-upstash-host:6379
DOCKER_REDIS_URL=redis://redis:6379

# MinIO object storage (local dev defaults match the docker-compose service below)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
DOCKER_MINIO_ENDPOINT=minio
DOCKER_MINIO_PORT=9000
DOCKER_MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dsms-files
MINIO_REGION=us-east-1
# Set to public-read only when you want anonymous downloads from the bucket.
MINIO_BUCKET_POLICY=private

# Super Admin bootstrap (use secrets in CI/CD; do not commit real values)
ENABLE_SUPER_ADMIN_BOOTSTRAP=false
SUPER_ADMIN_IDENTIFIER=
SUPER_ADMIN_PASSWORD=