// Prisma schema header: generator and datasource

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ===== src\modules\Auth\prisma\AuthSession.prisma =====
model AuthSession {
  id              String   @id @default(cuid())
  userId          String
  accessTokenJti  String   @unique
  refreshTokenHash String   @unique
  previousTokenHash String?
  tokenVersion    Int      @default(0)
  tenantId        String?
  branchId        String?
  revokedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  rememberMe      Boolean  @default(false)

  @@index([userId])
  @@index([tenantId, branchId])
  @@index([previousTokenHash])
}


// ===== src\modules\Auth\prisma\AuthUser.prisma =====
// Lightweight AuthUser model for authentication storage. In production, you
// may already have a Users table elsewhere; adapt accordingly.
model AuthUser {
  id         String   @id @default(cuid())
  identifier String   @unique
  password   String
  phoneNumber String?
  tenantId   String?
  branchId   String?
  roles      String[] @default([])
  isLocked             Boolean   @default(false)
  lockedAt             DateTime?
  unlockToken          String?   @unique
  unlockTokenExpiresAt DateTime?
  lockoutCount         Int       @default(0)
  reminder1hSent       Boolean   @default(false)
  reminder30mSent      Boolean   @default(false)
  reminder10mSent      Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId, branchId])
}


// ===== src\modules\Auth\prisma\Otp.prisma =====
model Otp {
  token     String   @id
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}


// ===== src\modules\Auth\prisma\Permission.prisma =====
model Permission {
  id         String           @id @default(cuid())
  key        String           @unique
  moduleName String
  action     String
  scope      PermissionScope
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@index([moduleName, action])
}


// ===== src\modules\Auth\prisma\Role.prisma =====
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
}


// ===== src\modules\Auth\prisma\RolePermission.prisma =====
model RolePermission {
  id           String      @id @default(cuid())
  roleId       String
  permissionId String
  tenantId     String?
  branchId     String?
  createdAt    DateTime    @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, tenantId, branchId])
  @@index([tenantId, branchId])
}


// ===== src\modules\Auth\prisma\UserRole.prisma =====
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  tenantId  String?
  branchId  String?
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId, branchId])
  @@index([userId, tenantId, branchId])
}


// ===== src\modules\Auth\prisma\enums.prisma =====
enum PermissionScope {
  global
  tenant
  branch
  own
}


// ===== src\modules\Notification\prisma\EmailMessage.prisma =====
model EmailMessage {
  id                String    @id @default(cuid())
  to                String
  subject           String
  body              String    @db.Text
  status            String    // 'PENDING', 'SENT', 'FAILED'
  providerMessageId String?   @unique
  errorMessage      String?
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  nextRetryAt       DateTime?
  tenantId          String?
  branchId          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([nextRetryAt])
  @@index([tenantId, branchId])
}


// ===== src\modules\Notification\prisma\SmsMessage.prisma =====
model SmsMessage {
  id                String    @id @default(cuid())
  to                String
  body              String
  status            String    // 'PENDING', 'SENT', 'DELIVERED', 'FAILED'
  providerMessageId String?   @unique
  errorMessage      String?
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  nextRetryAt       DateTime?
  tenantId          String?
  branchId          String?
  senderName        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([nextRetryAt])
  @@index([tenantId, branchId])
}


// ===== src\modules\Tenant\prisma\Tenant.prisma =====
model Tenant {
  id              String    @id @default(cuid())
  name            String
  slug            String?   @unique
  isActive        Boolean   @default(true)

  // Branding
  logoUrl         String?
  primaryColor    String?
  secondaryColor  String?
  faviconUrl      String?

  // Plan
  planTier        PlanTier  @default(BASIC)
  planExpiresAt   DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}


// ===== src\modules\Tenant\prisma\enums.prisma =====
enum PlanTier {
  BASIC
  STANDARD
  PREMIUM
}
